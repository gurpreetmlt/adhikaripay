NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Server-only — used by the BFF route handlers (app/api/auth/*, app/api/proxy/*) to call the real
# backend. Falls back to NEXT_PUBLIC_API_URL above if unset, so this is optional in practice; set
# it explicitly if the BFF should ever reach the backend via a different (e.g. internal) URL than
# the browser does.
API_URL=http://localhost:4000/api
