{
  "name": "@adhikaripay/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Adhikari Pay API — wallet, ledger, commission engine, provider wrapper layer",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/postgres/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "seed:catalog": "tsx scripts/seedCatalog.ts",
    "seed:providers": "tsx scripts/seedProviders.ts",
    "seed:mpin": "tsx scripts/seedLoginMpin.ts",
    "seed:txns": "tsx scripts/seedTxns.ts",
    "seed:network": "tsx scripts/seedNetwork.ts"
  },
  "dependencies": {
    "@adhikaripay/shared-types": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
