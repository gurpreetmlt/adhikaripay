NODE_ENV=development
PORT=4000

# PostgreSQL — wallets, ledger, transactions, commission, hierarchy
DATABASE_URL=postgres://adhikaripay:adhikaripay@localhost:5432/adhikaripay

# MongoDB — provider logs, audit logs, service catalog
MONGODB_URI=mongodb://localhost:27017/adhikaripay

# Redis — BullMQ commission/provider-retry queues
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key for encrypting PAN/Aadhaar at rest — must be exactly 32 bytes, base64-encoded
AES_ENCRYPTION_KEY=change-me-32-byte-base64-key

CORS_ORIGIN=http://localhost:3000
