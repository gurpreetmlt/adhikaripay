<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP to 127.0.0.1 only — required for local L1 RD Service (Mantra, Morpho, …).
     Remote API calls still use HTTPS (api.adhikaripay.com). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!--
      Pin the Let's Encrypt intermediate (YR2) that issues our leaf cert, not the leaf itself —
      LE rotates the leaf (and usually its key) every ~90 days on renewal, which would silently
      break leaf pinning. The intermediate is stable for years. Root (ISRG Root X1) is the backup
      pin. Pins expire 2027-07-17 (~1yr) — renew before then, or Android drops pinning back to
      normal CA trust for this domain (fails open, not closed).
    -->
    <domain-config>
        <domain includeSubdomains="false">api.adhikaripay.com</domain>
        <pin-set expiration="2027-07-17">
            <pin digest="SHA-256">nWN7PSep5XDQdge5zK24CnCRXHr3KvzhKEGxsdqCX9E=</pin>
            <pin digest="SHA-256">fk6IOKit1ild5647BH06ujSIq5XbCgqlbYl6ANhhi88=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
