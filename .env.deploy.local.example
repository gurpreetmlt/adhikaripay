# Copy this file to .env.deploy.local and fill in real values.
# .env.deploy.local is gitignored — never commit real Coolify tokens.
#
# Find these in Coolify:
#   COOLIFY_URL         — your Coolify instance base URL
#   COOLIFY_APP_UUID    — last segment of the application's dashboard URL
#                         (.../project/.../environment/.../application/<THIS>)
#   COOLIFY_TOKEN       — Keys & Tokens → API Tokens → New Token
#                         (needs "deploy" + "read" permissions)
COOLIFY_URL=http://your-coolify-host:8000
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
