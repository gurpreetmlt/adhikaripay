# Adhikari Pay — Environment

# Database — single PostgreSQL instance for all data
DATABASE_URL=postgresql://adhikaripay:adhikaripay@localhost:5432/adhikaripay

# Auth
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Aggregator API keys (never commit real values)
EKO_API_KEY=
EKO_API_SECRET=
PAYSPRINT_API_KEY=
PAYSPRINT_API_SECRET=

# Portal URLs
ADMIN_URL=http://localhost:3000
AGENT_WEB_URL=http://localhost:3001
API_URL=http://localhost:4000

# Mobile (Android) — point to VPS in production
# API_URL=https://api.adhikaripay.com
